d=actor_id)
+
+            user = app.state.security_store.activate_user_with_password(
+                access_id=clean_id,
+                email=clean_email,
+                password=body.password,
+                confirm_password=body.confirm_password,
+                audit_recorder=record_audit if getattr(app.state, "core_security_audit", None) is not None else None,
+            )
+
+            session = session_service.issue(
+                user=user,
+                route=AccessRoute.NORMAL,
+                mtls_verified=False,
+                step_up_satisfied=False,
+            )
+
+            if hasattr(app.state, "auth_policy") and app.state.auth_policy is not None:
+                _auth_limiter("login_limiter").record_success(ip_key)
+                if access_key is not None:
+                    _auth_limiter("login_limiter").record_success(access_key)
+
+            return {
+                "access_token": session.token,
+                "expires_at_utc": session.expires_at.isoformat(),
+                "subject": str(session.user.user_id),
+                "role": session.user.role.value,
+                "sx_id": session.user.sx_id,
+            }
+        except (SecurityError, SecurityStoreError, ValueError) as exc:
+            if hasattr(app.state, "auth_policy") and app.state.auth_policy is not None:
+                if access_key is not None:
+                    _auth_limiter("login_limiter").record_failure(access_key)
+                locked, rem = _auth_limiter("login_limiter").record_failure(ip_key)
+                if locked:
+                    raise HTTPException(
+                        status_code=429,
+                        detail=f"RATE_LIMIT_COOLDOWN: Cooldown active for {rem}s",
+                        headers={"Retry-After": str(rem)},
+                    ) from exc
+            raise HTTPException(status_code=400, detail=str(exc)) from exc
+
