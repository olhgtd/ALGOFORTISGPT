@@ -19,6 +20,39 @@ from pydantic import BaseModel, Field
 
 logger = logging.getLogger(__name__)
 
+# P1 SEC-004: bound limiter-key length and cardinality. Access-id keyed
+# buckets must not grow unbounded (memory/bucket pollution).
+LIMITER_KEY_MAX_LEN = 64
+LIMITER_MAX_KEYS = 500
+
+
+def _bounded_limiter_key(prefix: str, raw: str) -> str:
+    """Return a fixed-max-length limiter key for untrusted input."""
+    cleaned = (raw or "").strip().lower()
+    if len(cleaned) > 32:
+        digest = hashlib.sha256(cleaned.encode("utf-8")).hexdigest()[:32]
+        key = f"{prefix}:{digest}"
+    else:
+        safe = "".join(ch for ch in cleaned if ch.isalnum() or ch in ("-", "_", "@", "."))
+        key = f"{prefix}:{safe[:32]}"
+    return key[:LIMITER_KEY_MAX_LEN]
+
+
+def _bounded_access_key(tracker: Any, clean_id: str) -> str | None:
+    """Return bounded access-id limiter key, or None when cardinality cap is hit.
+
+    Existing keys keep working; new keys are refused once the tracker holds
+    LIMITER_MAX_KEYS entries so callers fall back to IP-only limiting.
+    """
+    key = _bounded_limiter_key("access_id", clean_id)
+    try:
+        records = getattr(tracker, "_records", None)
+        if records is not None and key not in records and len(records) >= LIMITER_MAX_KEYS:
+            return None
+    except Exception:
+        return None
+    return key
+
