+    class _NullLimiter:
+        def is_locked_out(self, key: str):
+            return False, 0
+        def record_failure(self, key: str):
+            return False, 0
+        def record_success(self, key: str) -> None:
+            return None
+        def clear(self, key: str) -> None:
+            return None
+        def record_request(self, key: str, max_requests=None, window_seconds: int = 60):
+            return False, 0
+
+    _NULL_LIMITER = _NullLimiter()
+
+    def _auth_limiter(name: str):
+        # P2-02/BUG-006: uniform non-optional guard; missing policy/limiter
+        # degrades to a no-op limiter instead of AttributeError.
+        try:
+            policy = getattr(app.state, "auth_policy", None)
+            if policy is None:
+                return _NULL_LIMITER
+            lim = getattr(policy, name, None)
+            return lim if lim is not None else _NULL_LIMITER
+        except Exception:
+            return _NULL_LIMITER
+
     def _check_expensive_throttle(user_id: str | UUID) -> None:
         if not hasattr(app.state, "auth_policy") or app.state.auth_policy is None:
             return
@@ -1000,6 +1071,117 @@ def create_app(*, owner: UserIdentity | None = None, config: SecurityConfigurati
         except SecurityError as exc:
