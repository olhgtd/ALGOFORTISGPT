+    @app.post("/api/v1/auth/local/access/validate")
+    def local_access_validate(body: LocalUserAccessValidateRequest, request: Request) -> dict[str, object]:
+        """Validate an invite-only Access ID for a prospective user."""
+        if app.state.security_store is None:
+            raise HTTPException(status_code=503, detail="Security store is unavailable")
+
+        clean_id = body.access_id.strip()
+        ip_key = f"ip:{_client_ip(request)}"
+        # P1 SEC-004: bound access-id limiter keys (length + cardinality).
+        access_key = _bounded_access_key(
+            _auth_limiter("login_limiter") if hasattr(app.state, "auth_policy") and app.state.auth_policy is not None else None,
+            clean_id,
+        ) if hasattr(app.state, "auth_policy") and app.state.auth_policy is not None else None
+
+        if hasattr(app.state, "auth_policy") and app.state.auth_policy is not None:
+            _check_cooldown(_auth_limiter("login_limiter"), ip_key)
+            if access_key is not None:
+                _check_cooldown(_auth_limiter("login_limiter"), access_key)
+
+        try:
+            res = app.state.security_store.validate_user_access_id(clean_id)
+            if hasattr(app.state, "auth_policy") and app.state.auth_policy is not None:
+                if access_key is not None:
+                    _auth_limiter("login_limiter").record_success(access_key)
+                _auth_limiter("login_limiter").record_success(ip_key)
+            return res
+        except (SecurityError, SecurityStoreError, ValueError) as exc:
+            if hasattr(app.state, "auth_policy") and app.state.auth_policy is not None:
+                if access_key is not None:
+                    _auth_limiter("login_limiter").record_failure(access_key)
+                locked, rem = _auth_limiter("login_limiter").record_failure(ip_key)
+                if locked:
+                    raise HTTPException(
+                        status_code=429,
+                        detail=f"RATE_LIMIT_COOLDOWN: Cooldown active for {rem}s",
+                        headers={"Retry-After": str(rem)},
+                    ) from exc
+            detail_str = str(exc)
+            status_code = 403 if "ACCESS_REVOKED" in detail_str or "ACCESS_SUSPENDED" in detail_str or "ACCESS_EXPIRED" in detail_str else 404
+            raise HTTPException(status_code=status_code, detail=detail_str) from exc
+
