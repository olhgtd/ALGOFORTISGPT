,
+phi,
+speed: 0.0007 + Math.random() * 0.0015,
+palette,
+rgb,
+});
+}
+
+let lastTime = performance.now();
+
+const render = (now: number) => {
+const delta = Math.min(0.1, (now - lastTime) / 1000);
+lastTime = now;
+
+// Full-HD / 4K High-DPI scaling
+const dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 3));
+const pixelWidth = Math.round(size * dpr);
+const pixelHeight = Math.round(size * dpr);
+
+if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
+canvas.width = pixelWidth;
+canvas.height = pixelHeight;
+}
+
+ctx.save();
+ctx.scale(dpr, dpr);
+ctx.clearRect(0, 0, size, size);
+
+const cx = size / 2;
+const cy = size / 2;
+
+// Calculate assemble progress during intro (0.5s to 2.2s)
+const currentIntro = introElapsed;
+let assembleProgress = 1.0;
+if (currentIntro < 0.5) {
+assembleProgress = 0.0;
+} else if (currentIntro < 2.2) {
+assembleProgress = Math.min(1.0, (currentIntro - 0.5) / 1.7);
+assembleProgress = 1 - Math.pow(1 - assembleProgress, 3);
+}
+
+// Smooth time-based rotation
+const rotationSpeed = verificationState === "VERIFYING_PASSKEY" ? 0.9 : 0.28;
+rotationAngle.current += rotationSpeed * delta;
+
+const angle = rotationAngle.current;
+const tilt = ringTilt.current;
+
+if (assembleProgress > 0.01) {
+// 1. Subtle, ultra-soft central ambient glow (silver/cool white falloff fading to 0)
+const ambientGlowRadius = radius * 1.35;
+const grad = ctx.createRadialGradient(cx, cy, radius * 0.08, cx, cy, ambientGlowRadius);
+grad.addColorStop(0, `rgba(210, 225, 245, ${0.12 * assembleProgress})`);
+grad.addColorStop(0.4, `rgba(180, 205, 235, ${0.03 * assembleProgress})`);
+grad.addColorStop(1, "rgba(0, 0, 0, 0)");
+
+ctx.fillStyle = grad;
+ctx.beginPath();
+ctx.arc(cx, cy, ambientGlowRadius, 0, Math.PI * 2);
+ctx.fill();
+
+// 2. Crisp Cryptographic Concentric Orbit Rings (Subtle cool gray / blue)
+ctx.lineWidth = 1;
+
+// Primary Orbital Ring (Tilted ellipse)
+ctx.save();
+ctx.translate(cx, cy);
+ctx.rotate(tilt);
+ctx.beginPath();
+ctx.ellipse(0, 0, radius * 1.05 * assembleProgress, radius * 0.42 * assembleProgress, angle * 0.35, 0, Math.PI * 2);
+ctx.strokeStyle = `rgba(180, 200, 230, ${0.28 * assembleProgress})`;
+ctx.setLineDash([4, 6]);
+ctx.stroke();
+ctx.restore();
+
+// Secondary Counter-Tilted Orbital Ring
+ctx.save();
+ctx.translate(cx, cy);
+ctx.rotate(-tilt * 0.85);
+ctx.beginPath();
+ctx.ellipse(0, 0, radius * 1.12 * assembleProgress, radius * 0.46 * assembleProgress, -angle * 0.25, 0, Math.PI * 2);
+ctx.strokeStyle = `rgba(160, 185, 220, ${0.22 * assembleProgress})`;
+ctx.setLineDash([7, 9]);
+ctx.stroke();
+ctx.restore();
+
+// Inner Core Latitude Ring
+ctx.save();
+ctx.translate(cx, cy);
+ctx.beginPath();
+ctx.ellipse(0, 0, radius * 0.68 * assembleProgress, radius * 0.26 * assembleProgress, 0, 0, Math.PI * 2);
+ctx.strokeStyle = `rgba(200, 220, 245, ${0.16 * assembleProgress})`;
+ctx.setLineDash([2, 5]);
+ctx.stroke();
+ctx.restore();
+
+// 3. Project 3D Point Lattice
+const projectedPoints: { x: number; y: number; z: number; scale: number; alpha: number; rgb: string }[] = [];
+
+for (let i = 0; i < points.length; i++) {
+const pt = points[i];
+pt.phi += pt.speed;
+
+const currentRadius = pt.baseRadius * assembleProgress + (1 - assembleProgress) * 70;
+
+// 3D coordinates on sphere
+const x0 = currentRadius * Math.sin(pt.theta) * Math.cos(pt.phi + angle);
+const y0 = currentRadius * Math.cos(pt.theta);
+const z0 = currentRadius * Math.sin(pt.theta) * Math.sin(pt.phi + angle);
+
+// Tilt around X-axis
+const cosT = Math.cos(tilt);
+const sinT = Math.sin(tilt);
+const y1 = y0 * cosT - z0 * sinT;
+const z1 = y0 * sinT + z0 * cosT;
+
+// Perspective projection
+const fov = 320;
+const scale = fov / (fov + z1);
+const x2d = cx + x0 * scale;
+const y2d = cy + y1 * scale;
+
+// Depth alpha: foreground is bright and sharp, background softly muted
+const normalZ = (z1 + radius) / (2 * radius);
+const alpha = Math.max(0.14, Math.min(1.0, 0.22 + normalZ * 0.78)) * assembleProgress;
+
+projectedPoints.push({ x: x2d, y: y2d, z: z1, scale, alpha, rgb: pt.rgb });
+}
+
+// Draw crisp connection lines between nearby points
+ctx.setLineDash([]);
+ctx.lineWidth = 0.65;
+const maxDist = 36 * assembleProgress;
+
+for (let i = 0; i < projectedPoints.length; i++) {
+const p1 = projectedPoints[i];
+if (p1.z < -radius * 0.35) continue; // Skip deep background for crisp visual clarity
+
+let connections = 0;
+for (let j = i + 1; j < projectedPoints.length; j++) {
+if (connections >= 3) break;
+const p2 = projectedPoints[j];
+const dx = p1.x - p2.x;
+const dy = p1.y - p2.y;
+const dist = Math.sqrt(dx * dx + dy * dy);
+
+if (dist < maxDist) {
+const lineAlpha = (1 - dist / maxDist) * 0.20 * Math.min(p1.alpha, p2.alpha);
+ctx.strokeStyle = `rgba(200, 220, 245, ${lineAlpha})`;
+ctx.beginPath();
+ctx.moveTo(p1.x, p1.y);
+ctx.lineTo(p2.x, p2.y);
+ctx.stroke();
+connections++;
+}
+}
+}
+
+// Draw individual lattice nodes with their stable assigned multi-color accents
+for (let i = 0; i < projectedPoints.length; i++) {
+const p = projectedPoints[i];
+const nodeRadius = Math.max(0.75, (p.z > 0 ? 1.55 : 0.95) * p.scale);
+
+// Node core dot
+ctx.fillStyle = `rgba(${p.rgb}, ${p.alpha})`;
+ctx.beginPath();
+ctx.arc(p.x, p.y, nodeRadius, 0, Math.PI * 2);
+ctx.fill();
+
+// Subtle crisp glow halo on prominent front nodes
+if (p.z > radius * 0.28) {
+ctx.fillStyle = `rgba(${p.rgb}, ${p.alpha * 0.32})`;
+ctx.beginPath();
+ctx.arc(p.x, p.y, nodeRadius * 2.1, 0, Math.PI * 2);
+ctx.fill();
+}
+}
+
+// 4. Central AlgoFortis Core Node (White / Silver Cryptographic Nucleus)
+const corePulse = 1.0 + Math.sin(now * 0.0028) * 0.06;
+const coreRadius = 12 * corePulse * assembleProgress;
+const centerGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, coreRadius);
+centerGrad.addColorStop(0, `rgba(255, 255, 255, ${0.92 * assembleProgress})`);
+centerGrad.addColorStop(0.35, `rgba(220, 235, 255, ${0.5 * assembleProgress})`);
+centerGrad.addColorStop(1, "rgba(255, 255, 255, 0)");
+
+ctx.fillStyle = centerGrad;
+ctx.beginPath();
+ctx.arc(cx, cy, coreRadius, 0, Math.PI * 2);
+ctx.fill();
+
+// Inner sharp bright point
+ctx.fillStyle = `rgba(255, 255, 255, ${0.98 * assembleProgress})`;
+ctx.beginPath();
+ctx.arc(cx, cy, 2.2 * assembleProgress, 0, Math.PI * 2);
+ctx.fill();
+
+// 5. State-Driven Verification Pulse Waves
+if (verificationState === "VERIFYING_PASSKEY") {
+const pulsePhase = (now % 1400) / 1400;
+const pulseR = radius * 0.35 + pulsePhase * radius * 0.85;
+ctx.beginPath();
+ctx.arc(cx, cy, pulseR, 0, Math.PI * 2);
+ctx.strokeStyle = `rgba(255, 255, 255, ${0.45 * (1 - pulsePhase)})`;
+ctx.lineWidth = 1.25;
+ctx.stroke();
+} else if (verificationState === "VERIFICATION_SUCCESS" || verificationState === "WORKSPACE_TRANSITION") {
+const successPhase = Math.min(1.0, ((now % 1600) / 1600));
+const successR = radius * 0.2 + successPhase * radius * 1.15;
+ctx.beginPath();
+ctx.arc(cx, cy, successR, 0, Math.PI * 2);
+ctx.strokeStyle = `rgba(255, 255, 255, ${0.65 * (1 - successPhase)})`;
+ctx.lineWidth = 1.5;
+ctx.stroke();
+}
+}
+
+ctx.restore();
+animFrameId.current = requestAnimationFrame(render);
+};
+
+animFrameId.current = requestAnimationFrame(render);
+
+return () => {
+cancelAnimationFrame(animFrameId.current);
+};
+}, [size, verificationState, introPhase, introElapsed]);
+
+return (
+<div
+className="algofortis-core-wrapper"
+style={{
+width: size,
+height: size,
+position: "relative",
+display: "flex",
+alignItems: "center",
+justifyContent: "center",
+userSelect: "none",
+pointerEvents: "none",
+}}
+>
+<canvas
+ref={canvasRef}
+style={{
+width: `${size}px`,
+height: `${size}px`,
+display: "block",
+}}
+/>
+</div>
+);
+};
